  "pi": {
    "version": ">=0.37.3",
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "telemetry",
    "llama.cpp",
    "ik_llama.cpp",
    "prompt-cache",
    "kv-cache",
    "speculative-decoding",
    "local-llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razlani/pi-llm-telemetry.git"
  },
  "bugs": {
    "url": "https://github.com/razlani/pi-llm-telemetry/issues"
  },
  "homepage": "https://github.com/razlani/pi-llm-telemetry#readme",
  "author": "Riaz Amlani",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
